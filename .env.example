# Native processes read exported environment variables; .env is not loaded automatically.
MAILENT_CORE_HOST=127.0.0.1
MAILENT_CORE_PORT=8080
MAILENT_CORE_LOG_LEVEL=info
MAILENT_CORE_ENVIRONMENT=development
# Optional: a validated YAML pack; default is the bundled modern pack.
# MAILENT_CORE_POLICY_PATH=policies/high-security/policy.yaml

# Vite development proxy (never a secret; browser uses same-origin paths).
MAILENT_CORE_PROXY_TARGET=http://127.0.0.1:8080

# Sensor --sample identity. Capture/forwarding are not implemented yet.
MAILENT_SENSOR_ID=sensor-local-01
MAILENT_SENSOR_SITE_ID=site-local-dev
MAILENT_SENSOR_BUFFER_SIZE=1000

# Probe scope is empty by default. Network probes are not implemented yet.
MAILENT_PROBE_ALLOWED_DOMAINS=

# This slice uses in-memory storage. Database and Jev adapters are not wired.
# Optional Compose broker: --profile distributed; localhost:19092.

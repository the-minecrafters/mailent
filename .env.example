# Core loads .env locally. Keep real credentials in .env or Render environment settings.
MAILENT_CORE_HOST=127.0.0.1
MAILENT_CORE_PORT=8080
MAILENT_CORE_ENVIRONMENT=development
MAILENT_CORE_PROXY_TARGET=http://127.0.0.1:8080

# Supabase PostgreSQL session pooler URL. No value means temporary local storage.
MAILENT_DATABASE_URL=
# For the private schema deployed by supabase/migrations:
# MAILENT_DATABASE_SCHEMA=mailent
# MAILENT_RUN_MIGRATIONS=false

# Required for cloud deployments. Only publishable keys belong in browser config.
# MAILENT_SUPABASE_URL=https://PROJECT.supabase.co
# MAILENT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# MAILENT_ALLOWED_EMAILS=owner@your-domain.com

MAILENT_JEV_ENABLED=true
MAILENT_JEV_BASE_URL=https://api.codiv.ai
MAILENT_JEV_MODEL=openjev-latest
MAILENT_JEV_API_KEY=

# Collector and explicitly authorized active-probe scope.
MAILENT_SENSOR_ID=collector-local
MAILENT_SENSOR_SITE_ID=local
MAILENT_SENSOR_BUFFER_SIZE=1000
MAILENT_PROBE_ALLOWED_DOMAINS=

# Match this server-side secret in deployed collectors; use at least 32 random characters.
MAILENT_COLLECTOR_TOKEN=
